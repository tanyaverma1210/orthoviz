{
  "name": "orthoviz",
  "productName": "OrthoViz",
  "version": "0.1.0",
  "description": "View a cervical-spine CT scan as a 3D model",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test tests/unit",
    "test:e2e": "node tests/e2e/run-patient1.mjs",
    "test:viewer": "node tests/e2e/viewer-interactions.mjs",
    "build:backend": "cd ../backend && .venv/bin/pyinstaller --noconfirm --log-level WARN --distpath build/dist --workpath build/work packaging/orthoviz-segment.spec",
    "build:resources": "node scripts/prepare-resources.mjs",
    "dist": "npm run build:resources && electron-builder --mac",
    "dist:dir": "npm run build:resources && electron-builder --mac dir",
    "test:packaged": "node tests/e2e/packaged-offline.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  },
  "author": "OrthoViz project",
  "build": {
    "appId": "org.orthoviz.app",
    "productName": "OrthoViz",
    "copyright": "OrthoViz project",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      {
        "from": "node_modules/three/examples/jsm/controls",
        "to": "node_modules/three/examples/jsm/controls",
        "filter": [
          "OrbitControls.js"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../backend/build/dist/orthoviz-segment",
        "to": "backend/orthoviz-segment"
      },
      {
        "from": "build-resources/totalsegmentator-weights",
        "to": "totalsegmentator-weights"
      },
      {
        "from": "build-resources/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "OrthoViz"
    }
  }
}
